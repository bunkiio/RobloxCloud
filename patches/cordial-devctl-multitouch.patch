 /// not silently swallow every `openWindow` with no explanation, which is
 /// exactly the failure this whole module exists to end.
+/// Web views on the X11 backend.
+///
+/// The presenter below attaches every `openWindow` to the Wayland host window,
+/// which the X11 backend does not have, so there every request -- sign-up's
+/// captcha, sign-in challenges, Join, Robux -- was dropped and the engine sat
+/// on a blank screen. Here the pump thread takes GLib's default main context
+/// for good and advances it once per tick (nothing else iterates it on X11, and
+/// sources such as the battery report were already attached to it from this
+/// thread), so the presenter's `invoke`s land on the pump thread, which brings
+/// GTK up for X11 on first use and opens each request in a plain top-level
+/// window holding the same dialog the Wayland path shows.
+#[cfg(feature = "webview")]
+mod x11_web {
+    use gtk4::glib;
+    use gtk4::prelude::*;
+
+    /// On the pump thread, before the pump starts.
+    pub fn arm() {
+        match glib::MainContext::default().acquire() {
+            // Held for the life of the process: the pump thread is GTK's now.
+            Ok(guard) => std::mem::forget(guard),
+            Err(e) => {
+                println!("  webview: could not take GLib's main context ({e}); web views stay unavailable");
+                return;
+            }
+        }
+        let _ = cordial_runtime::android::looper::TICK.set(|| {
+            let context = glib::MainContext::default();
+            for _ in 0..64 {
+                if !context.iteration(false) {
+                    break;
+                }
+            }
+        });
+        println!("  webview: no Wayland host window; web views will open in their own X11 window");
+    }
+
+    fn gtk_up() -> bool {
+        static UP: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+        *UP.get_or_init(|| {
+            // SAFETY: set before GTK is initialised, on the thread that is
+            // about to do it; nothing else here reads GDK's variables.
+            if let Err(e) = unsafe { glib::setenv("GDK_BACKEND", "x11", true) } {
+                println!("[webview] could not set GDK_BACKEND=x11: {e}");
+            }
+            gtk4::gdk::set_allowed_backends("x11");
+            // Not "Cordial": that WM_CLASS names the game window.
+            glib::set_prgname(Some("cordial-web"));
+            match libadwaita::init() {
+                Ok(()) => true,
+                Err(e) => {
+                    println!("[webview] GTK would not start on X11, so web views stay unavailable: {e}");
+                    false
+                }
+            }
+        })
+    }
+
+    /// Roblox's pages choose how they talk back to the app from the
+    /// User-Agent. Under the default Windows identity a check page looks for
+    /// the Windows app's `window.external`, which does not exist here, so it
+    /// never reports that it loaded or passed, and the engine gives up after
+    /// 60 seconds and goes back to sign-up or sign-in. The pages are told
+    /// this is the Android app instead (the string Cordial's own
+    /// `android-tablet` identity sends), whose `__globalRobloxAndroidBridge__`
+    /// Cordial provides; the engine keeps its own identity.
+    fn android_user_agent(ua: &str) -> String {
+        const WINDOWS: &str = "ROBLOX Windows App ";
+        let Some(at) = ua.find(WINDOWS) else {
+            return ua.to_string();
+        };
+        let version = ua[at + WINDOWS.len()..].split(' ').next().unwrap_or_default();
+        let device = ua[..at].replacen("; Cordial)", "; Cordial; 33)", 1);
+        format!(
+            "{device}ROBLOX Android App {version} Tablet Hybrid()  GooglePlayStore \
+             RobloxApp/{version} (GlobalDist; GooglePlayStore)"
+        )
+    }
+
+    /// The presenter's X11 half; runs on the pump thread.
+    pub fn open(request: cordial_runtime::webview::OpenWindowRequest) {
+        if !gtk_up() {
+            return;
+        }
+        let cookie =
+            cordial_runtime::webview::roblox_session_cookie(&cordial_runtime::profile::active());
+        let mut shell_request = cordial_runtime::webview::to_shell_request(&request, cookie);
+        shell_request.user_agent = shell_request.user_agent.map(|ua| android_user_agent(&ua));
+        let host = gtk4::Window::builder().title("Roblox").default_width(1280).default_height(720).build();
+        host.present();
+        match cordial_shell::webview::open(&host, &shell_request) {
+            Some(dialog) => {
+                use libadwaita::prelude::AdwDialogExt;
+                println!("[webview] presented an openWindow request in its own X11 window");
+                let window = host.clone();
+                dialog.connect_closed(move |_| {
+                    window.close();
+                    cordial_runtime::webview::report_window_closed();
+                });
+                // The engine closes the page itself when a check passes
+                // (`closeWindow`), and that path does not end in `closed`:
+                // without this the empty host window stayed on top of the
+                // game as a blank white screen.
+                let window = host.clone();
+                dialog.connect_unmap(move |_| window.close());
+            }
+            None => {
+                host.close();
+                println!("[webview] openWindow request was refused by policy before it could be presented");
+            }
+        }
+    }
+}
